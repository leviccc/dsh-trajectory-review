{
  "name": "dsh-trajectory-review",
  "version": "0.1.6",
  "private": true,
  "description": "Real-time four-dimension review of a DSH session trajectory, shown in its own conversation view tab.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/core.test.mjs test/host.test.mjs test/client-smoke.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "trajectory",
    "review",
    "evaluation",
    "cordis"
  ]
}
